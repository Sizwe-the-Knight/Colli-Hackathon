# Documentation only: the application does not automatically load this file.
# Inject secrets privately into the process environment; never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated exact origins, without paths or trailing slashes.
# Omit CORS_ORIGINS when cross-origin access is unnecessary.
# SESSION_SECRET: required, privately supplied, at least 32 characters.
# DATABASE_URL: required, privately supplied for colli_app and colli_dev_disposable.
# Production additionally requires FRONTEND_DIST (absolute built frontend path).
# Render uses PROXY_MODE=render and platform identity checks; omit
# TRUSTED_PROXY_ADDRESSES there. Other hosts require verified explicit proxy peers.
# Authentication attempts persist in PostgreSQL after reviewed migration 0005.
# See DEPLOYMENT.md. No wildcard proxy trust or ephemeral authentication limiter.

# Narration is OFF. Enabling it requires separate approval for live credit usage.
NEBIUS_NARRATION_ENABLED=false
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_MAX_CALLS=0
NEBIUS_TOKEN_BUDGET=0
# NEBIUS_API_KEY: privately injected into the API process ONLY, never VITE_*.
# NEBIUS_BUDGET_FILE: absolute path to a pre-created empty nebius-budget.jsonl
# on persistent private storage. See artifacts/api-server/src/operational/NARRATOR.md.
